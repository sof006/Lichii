# Writes OUTPUT, a header holding a hash of the lowering sources: FILES (paths relative to
# SOURCE_DIR, separated by "|"). Line endings don't count, so checkouts with either hash the same.
# FILES_FROM instead names a file listing them, one per line (for lists too long for a command
# line). NAMESPACE and NAME name the constant (default
# VideoCommon::ShaderCacheV2::GeneratedLoweringStamp).

if (NOT NAMESPACE)
    set(NAMESPACE "VideoCommon::ShaderCacheV2")
endif()
if (NOT NAME)
    set(NAME "GeneratedLoweringStamp")
endif()

if (FILES_FROM)
    file(STRINGS "${FILES_FROM}" files)
else()
    string(REPLACE "|" ";" files "${FILES}")
endif()
set(combined "")
foreach (file IN LISTS files)
    file(READ "${SOURCE_DIR}/${file}" content)
    string(REPLACE "\r" "" content "${content}")
    string(SHA256 hash "${content}")
    string(APPEND combined "${file} ${hash}\n")
endforeach()
string(SHA256 stamp "${combined}")
string(SUBSTRING "${stamp}" 0 16 stamp)

file(WRITE "${OUTPUT}.tmp" "// Generated by CMakeModules/GenerateShaderLoweringStamp.cmake

#pragma once

#include \"common/common_types.h\"

namespace ${NAMESPACE} {

inline constexpr u64 ${NAME} = 0x${stamp}ULL;

} // namespace ${NAMESPACE}
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
